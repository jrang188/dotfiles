# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Justfiles (canonical 4-space recipe indentation)
[justfile]
indent_style = space
indent_size = 4

# Makefiles still drive the sketchybar helper C builds and need real tabs
[Makefile, makefile]
indent_style = tab
