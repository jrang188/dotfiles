{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2-pro",
  "plugin": [],
  "mcp": {
    "nixos": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-nixos"
      ],
      "enabled": true
    },
    "astro": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true
    },
    "kubernetes": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@latest"
      ],
      "enabled": true
    },
    "pulumi": {
      "type": "remote",
      "url": "https://mcp.ai.pulumi.com/mcp",
      "enabled": true
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "permission": {
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/get-shit-done/*": "allow"
    }
  }
}
